{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zebra Configure",
  "version": "0.3.1",
  "identifier": "com.jt1280.zebra-configure",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Zebra Configure",
        "width": 1180,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "jctaylorjr",
    "shortDescription": "Configures Zebra printers over the network",
    "longDescription": "Sets up Zebra printers from profiles and USB mirror folders, shows one printer's status and settings, and diagnoses problems.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
